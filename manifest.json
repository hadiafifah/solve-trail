{
  "manifest_version": 3,
  "name": "SolveTrail",
  "version": "0.1.0",
  "description": "Save coding practice to GitHub",

  "permissions": ["storage", "activeTab", "scripting"],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ]
}
